{
  "manifest_version": 3,
  "name": "TinyWorld",
  "version": "1.0.0",
  "description": "A little world, just for you. A cozy miniature floating island to visit whenever you need a short break.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "TinyWorld",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
